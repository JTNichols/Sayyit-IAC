{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "6046499583601852245"
    }
  },
  "parameters": {
    "env": {
      "type": "string"
    },
    "baseName": {
      "type": "string"
    },
    "deploymentPrincipalObjectId": {
      "type": "string"
    },
    "AZURE_GITHUB_OIDC_SP_ID": {
      "type": "securestring"
    },
    "sqlServerAdministratorPassword": {
      "type": "securestring",
      "defaultValue": ""
    },
    "updatePassword": {
      "type": "bool",
      "defaultValue": false
    },
    "modifyExternalIdTenant": {
      "type": "bool",
      "defaultValue": false
    },
    "externalIdDataLocation": {
      "type": "string",
      "defaultValue": "United States"
    },
    "externalIdSkuName": {
      "type": "string",
      "defaultValue": "Base",
      "allowedValues": [
        "Base"
      ]
    },
    "locationRG": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "locationWebApp": {
      "type": "string",
      "defaultValue": "centralus"
    },
    "locationSqlServer": {
      "type": "string",
      "defaultValue": "centralus"
    },
    "sqlServerAdminLoginName": {
      "type": "string",
      "defaultValue": "sqladminuser"
    }
  },
  "variables": {
    "commonTags": {
      "project": "[parameters('baseName')]"
    },
    "keyVaultSecretsUserRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
    "keyVaultSecretsOfficerRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7')]",
    "githubOidcServicePrincipalObjectId": "[parameters('AZURE_GITHUB_OIDC_SP_ID')]",
    "sqlServerProperties": "[union(createObject('administratorLogin', parameters('sqlServerAdminLoginName'), 'version', '12.0', 'minimumTlsVersion', '1.2', 'publicNetworkAccess', 'Disabled'), if(parameters('updatePassword'), createObject('administratorLoginPassword', parameters('sqlServerAdministratorPassword')), createObject()))]"
  },
  "imports": {
    "graphV1": {
      "provider": "MicrosoftGraph",
      "version": "1.0.0"
    }
  },
  "resources": {
    "dev_AppServicePlan": {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "sayyit-dev-asp",
      "location": "[parameters('locationWebApp')]",
      "sku": {
        "name": "F1",
        "tier": "Free"
      },
      "tags": "[variables('commonTags')]"
    },
    "dev_WebApp": {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "sayyit-dev-web",
      "location": "[parameters('locationWebApp')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', 'sayyit-dev-asp')]"
      },
      "tags": "[variables('commonTags')]",
      "dependsOn": [
        "dev_AppServicePlan"
      ]
    },
    "dev_WebApi": {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "sayyit-dev-api",
      "location": "[parameters('locationWebApp')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', 'sayyit-dev-asp')]"
      },
      "tags": "[variables('commonTags')]",
      "dependsOn": [
        "dev_AppServicePlan"
      ]
    },
    "dev_KeyVault": {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "sayyit-dev-kv",
      "location": "[parameters('locationRG')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enabledForTemplateDeployment": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 30,
        "publicNetworkAccess": "Disabled",
        "networkAcls": {
          "defaultAction": "Deny",
          "bypass": "AzureServices"
        }
      }
    },
    "dev_WebAppKeyVaultSecretsUser": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', 'sayyit-dev-kv')]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', 'sayyit-dev-kv'), resourceId('Microsoft.Web/sites', 'sayyit-dev-web'), 'KeyVaultSecretsUser')]",
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUserRoleDefinitionId')]",
        "principalId": "[reference('dev_WebApp', '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "dev_KeyVault",
        "dev_WebApp"
      ]
    },
    "dev_GitHubOidcPrincipalKeyVaultSecretsUser": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', 'sayyit-dev-kv')]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', 'sayyit-dev-kv'), variables('githubOidcServicePrincipalObjectId'), 'GitHubOidcKeyVaultSecretsUser')]",
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUserRoleDefinitionId')]",
        "principalId": "[variables('githubOidcServicePrincipalObjectId')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "dev_KeyVault"
      ]
    },
    "dev_GhDeployPrincipalSecretsOfficer": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', 'sayyit-dev-kv')]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', 'sayyit-dev-kv'), parameters('deploymentPrincipalObjectId'), 'KeyVaultSecretsOfficer')]",
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsOfficerRoleDefinitionId')]",
        "principalId": "[parameters('deploymentPrincipalObjectId')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "dev_KeyVault"
      ]
    },
    "dev_SqlServer": {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01-preview",
      "name": "sayyit-dev-sqlserver",
      "location": "[parameters('locationSqlServer')]",
      "tags": "[variables('commonTags')]",
      "properties": "[variables('sqlServerProperties')]"
    },
    "dev_SqlDatabase": {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01-preview",
      "name": "[format('{0}/{1}', 'sayyit-dev-sqlserver', 'sayyit-dev-db')]",
      "location": "[parameters('locationSqlServer')]",
      "tags": "[variables('commonTags')]",
      "sku": {
        "name": "Basic",
        "tier": "Basic"
      },
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 2147483648
      },
      "dependsOn": [
        "dev_SqlServer"
      ]
    },
    "dev_SqlAdminPasswordSecret": {
      "condition": "[parameters('updatePassword')]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', 'sayyit-dev-kv', 'sqlServerAdministratorPassword')]",
      "properties": {
        "value": "[parameters('sqlServerAdministratorPassword')]"
      },
      "dependsOn": [
        "dev_KeyVault"
      ]
    },
    "externalIdTenant": {
      "condition": "[parameters('modifyExternalIdTenant')]",
      "type": "Microsoft.AzureActiveDirectory/ciamDirectories",
      "apiVersion": "2023-05-17-preview",
      "name": "sayyit.onmicrosoft.com",
      "location": "[parameters('externalIdDataLocation')]",
      "tags": "[variables('commonTags')]",
      "sku": {
        "name": "[parameters('externalIdSkuName')]",
        "tier": "A0"
      },
      "properties": {
        "createTenantProperties": {
          "displayName": "sayyit",
          "countryCode": "US"
        }
      }
    },
    "dev_ExternalWebAppRegistration": {
      "condition": "[and(parameters('modifyExternalIdTenant'), equals(parameters('env'), 'dev'))]",
      "import": "graphV1",
      "type": "Microsoft.Graph/applications@v1.0",
      "properties": {
        "uniqueName": "sayyit-web-dev",
        "displayName": "sayyit-web-dev",
        "signInAudience": "AzureADandPersonalMicrosoftAccount"
      }
    }
  },
  "outputs": {
    "devKeyVaultName": {
      "type": "string",
      "value": "sayyit-dev-kv"
    },
    "devKeyVaultUri": {
      "type": "string",
      "value": "[reference('dev_KeyVault').vaultUri]"
    },
    "devWebAppPrincipalId": {
      "type": "string",
      "value": "[reference('dev_WebApp', '2023-12-01', 'full').identity.principalId]"
    }
  }
}